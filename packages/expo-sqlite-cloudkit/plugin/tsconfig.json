{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": [],
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "module": "Node16",
    "moduleResolution": "Node16",
    "verbatimModuleSyntax": false,
    "declaration": true,
    "rootDir": "src",
    "outDir": "build"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
